    "evidence-install-uninstall": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "install-uninstall" } } }
      ]
    },
    "evidence-model-checksum-load": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "model-checksum-load" } } }
      ]
    },
    "evidence-ten-thousand-chunk-build": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "ten-thousand-chunk-build" } } }
      ]
    },
    "evidence-ann-index-created": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "ann-index-created" } } }
      ]
    },
    "evidence-series-prefilter-before-ann": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "series-prefilter-before-ann" } } }
      ]
    },
    "evidence-zero-cross-series-hits": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "properties": { "criterion": { "const": "zero-cross-series-hits" } } }
