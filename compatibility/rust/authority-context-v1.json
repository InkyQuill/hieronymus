  "batch_item_claims": {
    "type": "array",
    "items": {
      "$ref": "#/$defs/ClaimInput"
    },
    "default": [],
    "description": "Ordinary ClaimInput assertions for this item. text and concept_id are siblings of applicability; missing resolved context or knowledge gates keep claims conservatively excluded from current truth."
  },
  "definitions": {
    "StoryViewpoint": {
      "oneOf": [
        {
          "enum": [
            "Narrator",
            "Unspecified"
          ]
        },
        {
          "type": "object",
          "properties": {
            "Character": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "Character"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ApplicabilityV1": {
      "type": "object",
      "properties": {
        "series_id": {
          "type": "integer",
          "minimum": 1
        },
        "timeline_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "volume_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chapter_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_predicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_state": {
          "enum": [
            "Resolved",
            "Unspecified"
          ]
        },
        "knowledge_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "viewpoint": {
                "oneOf": [
                  {
                    "enum": [
                      "Narrator",
                      "All"
                    ]
                  },
                  {
                    "type": "object",
                    "properties": {
                      "Character": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "Character"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "known_from": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "known_until": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "viewpoint",
              "known_from",
              "known_until"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "series_id",
        "timeline_id",
        "volume_key",
        "chapter_key",
        "scope_predicates",
        "valid_from",
        "valid_until",
        "metadata_state",
        "knowledge_gates"
      ],
      "additionalProperties": false
    },
    "ClaimInput": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "concept_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityV1"
        }
      },
      "required": [
        "text",
        "concept_id",
        "applicability"
      ],
      "additionalProperties": false
    },
    "ExistingClaimInput": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "integer",
          "minimum": 1
        },
        "concept_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityV1"
        }
      },
      "required": [
        "claim_id",
        "concept_id",
        "applicability"
      ],
      "additionalProperties": false
    }
  }
