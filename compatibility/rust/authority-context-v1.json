        "default": [],
        "description": "Ordinary captured assertions; never explicit-user authority."
      }
    },
    "hieronymus_rag_import": {
      "claims": {
        "type": "object",
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "description": "New claims keyed by zero-based numeric chunk index, for example {\"0\":[{\"text\":\"Alex speaks briefly.\",\"concept_id\":2,\"applicability\":{...}}]}. text and concept_id belong on ClaimInput, outside applicability.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ClaimInput"
          }
        }
      },
      "claim_lineage": {
        "type": "object",
        "propertyNames": {
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "description": "Existing claim identities keyed by zero-based numeric chunk index. Use only to bind an already observed claim_id; use claims to create a new assertion.",
        "additionalProperties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExistingClaimInput"
          }
        }
      }
    }
