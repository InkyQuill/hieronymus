        },
        "volume": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "series_slug"
      ],
      "title": "SessionStartInput",
      "type": "object"
    }
  },
  "hieronymus_short_term_add": {
    "description": "Add a short-term memory to an active session.\n\nsource_role is an optional freeform provenance label. It does not control dreaming's\ncrystal type or confidence; use source_credibility and rule_intent for those signals.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "language_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "metadata": {
          "default": {}
        },
        "rule_intent": {
          "default": "",
          "type": "string"
        },
        "semantic_tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_id": {
          "format": "int64",
          "type": "integer"
        },
        "soft_origin": {
          "default": "",
          "type": "string"
        },
        "source_credibility": {
          "default": "observation",
          "type": "string"
        },
        "source_ref": {
          "default": "",
          "type": "string"
        },
        "source_role": {
          "default": "agent",
          "type": "string"
        },
        "story_scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "kind",
        "text"
      ],
      "title": "ShortAddInput",
      "type": "object"
    }
  },
  "hieronymus_short_term_add_batch": {
    "description": "Atomically add up to 500 short-term memories to one active session.\n\nEach item requires kind and text. source_role is optional freeform provenance metadata and\ndefaults to agent; it does not control dreaming's categorization or confidence.",
    "input_schema": {
      "$defs": {
        "ShortItemInput": {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "language_tags": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "metadata": {
              "default": {}
            },
            "rule_intent": {
              "default": "",
              "type": "string"
            },
            "semantic_tags": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "soft_origin": {
              "default": "",
              "type": "string"
            },
            "source_credibility": {
              "default": "observation",
              "type": "string"
            },
            "source_ref": {
              "default": "",
              "type": "string"
            },
            "source_role": {
              "default": "agent",
              "type": "string"
            },
            "story_scopes": {
              "default": [],
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/ShortItemInput"
          },
          "type": "array"
        },
        "session_id": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "session_id",
        "items"
      ],
      "title": "ShortBatchInput",
      "type": "object"
    }
  },
  "hieronymus_status": {
