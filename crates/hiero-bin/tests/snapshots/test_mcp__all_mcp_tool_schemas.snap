          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "series_id": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "series_id",
        "language_tags"
      ],
      "title": "SeriesTagsInput",
      "type": "object"
    }
  },
  "hieronymus_session_complete": {
    "description": "Complete an agent workflow session so it can be dreamed.",
    "input_schema": {
