{
  "hieronymus_concept_archive": {
    "description": "Archive a concept so recall and strict rule logic stop using it.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "format": "int64",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "concept_id"
      ],
      "title": "ConceptArchiveInput",
      "type": "object"
    }
  },
  "hieronymus_concept_create": {
