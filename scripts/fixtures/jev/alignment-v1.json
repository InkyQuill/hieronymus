{
  "version": "alignment-v1",
  "instructions": "Compare the two entity mentions using supplied evidence only. Labels or translation resemblance alone do not establish identity. Keep source IDs attached; no merge is authorized.",
  "criteria": {
    "same_entity": "Evidence explicitly links both mentions to one entity.",
    "related_distinct": "Two distinct entities with an explicit relationship.",
    "different": "Clearly different entities.",
    "insufficient_context": "Evidence cannot establish identity or distinction."
  },
