{
  "version": "literary-comparison-v1",
  "cases": [
    {
      "id": "en-equivalent",
      "language": "en",
      "left": "Mira bought a sword.",
      "right": "Mira purchased a sword.",
      "expected": "equivalent"
    },
    {
      "id": "en-negation",
      "language": "en",
      "left": "Mira opened the gate.",
      "right": "Mira did not open the gate.",
      "expected": "contradictory"
    },
    {
      "id": "en-number",
      "language": "en",
      "left": "Mira has five coins.",
      "right": "Mira has six coins.",
      "expected": "distinct"
    },
    {
      "id": "en-time",
      "language": "en",
      "left": "In volume 1 Mira is level 4.",
      "right": "In volume 3 Mira is level 9.",
      "expected": "distinct"
    },
    {
      "id": "en-viewpoint",
      "language": "en",
      "left": "Kai believes Mira is a spy.",
      "right": "Mira is a spy.",
      "expected": "distinct"
    },
    {
      "id": "en-ambiguous",
      "language": "en",
      "left": "She found it there.",
      "right": "Mira found the sword in the tower.",
      "expected": "insufficient_context"
    },
    {
      "id": "ru-equivalent",
      "language": "ru",
      "left": "Мира приобрела меч.",
      "right": "Мира купила меч.",
      "expected": "equivalent"
    },
    {
      "id": "ru-negation",
      "language": "ru",
      "left": "Мира открыла ворота.",
