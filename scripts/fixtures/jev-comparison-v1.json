      "expected": "contradictory"
    },
    {
      "id": "ru-number",
      "language": "ru",
      "left": "У Миры пять монет.",
      "right": "У Миры шесть монет.",
      "expected": "distinct"
    },
    {
      "id": "ru-time",
      "language": "ru",
      "left": "В первом томе уровень Миры — 4.",
      "right": "В третьем томе уровень Миры — 9.",
      "expected": "distinct"
    },
    {
      "id": "ru-viewpoint",
      "language": "ru",
      "left": "Кай считает Миру шпионкой.",
