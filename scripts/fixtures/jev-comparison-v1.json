      "expected": "distinct"
    },
    {
      "id": "en-name",
      "language": "en",
      "left": "Mira bought a sword.",
      "right": "Kai bought a sword.",
      "expected": "distinct"
    },
    {
      "id": "en-scope",
      "language": "en",
      "left": "In the northern kingdom, the king is dead.",
      "right": "In the southern kingdom, the king is alive.",
      "expected": "distinct"
